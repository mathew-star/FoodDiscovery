# Names only. Copy to .env and fill locally; set the same names in Vercel. Never commit values.

# Postgres: Neon in production; a local Postgres 16 + PostGIS works for development
DATABASE_URL=
# neon (default, Neon serverless drivers) | pg (node-postgres, for local and CI databases)
DATABASE_DRIVER=

# Upstash Redis (TLS, rediss://)
REDIS_URL=

# Cloudflare R2 (S3 API)
R2_ACCOUNT_ID=
S3_API=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Cloudflare API token (not read by app code)
API_TOKEN=

# Email: Resend key, and the verified sender, e.g. FDN <hello@your-domain> (defaults to Resend's test sender)
RESEND_API_KEY=
EMAIL_FROM=
# Development and e2e only: write emails as JSON files here instead of sending them
EMAIL_OUTBOX_DIR=

# Better Auth
BETTER_AUTH_API_KEY=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Set to 1 to check Neon, Redis and R2 at server start (off by default to keep cold starts fast)
STARTUP_CHECKS=
