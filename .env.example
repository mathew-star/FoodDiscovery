# Names only. Copy to .env and fill locally; set the same names in Vercel. Never commit values.

# Neon Postgres
DATABASE_URL=

# Upstash Redis (TLS, rediss://)
REDIS_URL=

# Cloudflare R2 (S3 API)
R2_ACCOUNT_ID=
S3_API=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Cloudflare API token (not read by app code)
API_TOKEN=

# Email
RESEND_API_KEY=

# Better Auth
BETTER_AUTH_API_KEY=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
